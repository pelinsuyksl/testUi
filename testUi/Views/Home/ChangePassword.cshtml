
@{
    ViewBag.Title = "Change Password";
}

<div style="display: flex; flex-direction: column; align-items: center; justify-content: center; margin-top: 50px; text-align: center;">
    <div class="card-container">
        <h2 style="text-align: center; margin-bottom: 20px;">Change Password</h2>
        <div class="form-group">
            <label>Email:</label>
            <input type="email" id="passEmail" class="form-control" />
        </div>
        <div class="form-group">
            <label>Old Password:</label>
            <input type="password" id="passOld" class="form-control" />
        </div>
        <div class="form-group">
            <label>New Password:</label>
            <input type="password" id="passNew" class="form-control" />
        </div>

        <button onclick="changePassword()" class="btn" style="background-color: #eb6161; border: none;">Update Password</button>
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary" style="background-color: #d44545; border:none;">Home</a>

        <div id="result" class="result-msg"></div>
    </div>
</div>

<script>
    window.changePassword = async function () {
        const emailElem = document.getElementById('passEmail');
        const oldPassElem = document.getElementById('passOld');
        const newPassElem = document.getElementById('passNew');
        const resultDiv = document.getElementById('result');

        const email = emailElem ? emailElem.value.trim() : '';
        const oldPassword = oldPassElem ? oldPassElem.value : '';
        const newPassword = newPassElem ? newPassElem.value : '';

        if (!email || !oldPassword || !newPassword) {
            if (resultDiv) {
                resultDiv.style.color = 'red';
                resultDiv.innerHTML = 'Email, Old Password and New Password are all required!';
            }
            return;
        }

        if (!email.includes('@@')) {
            if (resultDiv) {
                resultDiv.style.color = 'red';
                resultDiv.innerHTML = 'Enter a valid E-mail!';
            }
            return;
        }

        const dto = {
            Email: email,
            p_old: oldPassword,
            p_new: newPassword
        };
        const response = await sendApiRequest('user/password_change', dto);

        if (resultDiv && response) {
            if (response.Status || response.status) {
                resultDiv.style.color = 'green';
                resultDiv.innerHTML = response.Message || response.message || 'Password has changed successfully.';
            } else {
                resultDiv.style.color = 'red';
                resultDiv.innerHTML = response.Message || response.message || 'Password can not be changed!';
            }
        }
    };
</script>